+            std::fprintf(donutTrace, "tick,radius,base_r,target_r,v_t,v_r,exponent,exp,magnitude,lin_x,lin_y,lin_z\n");
+          }
+        }
+      }
+      if (donutTrace != nullptr) {
+        std::fprintf(donutTrace, "%u,%.5g,%.5g,%.5g,%.5g,%.5g,%.5g,%.5g,%.5g,%.5g,%.5g,%.5g\n",
+                     CMwCmdBufferCore::Current()->Timer().GetTickTime(), radius,
