diff --git a/src/engine/physics/world/physics_step.cpp b/src/engine/physics/world/physics_step.cpp
index 0ad1223..94236db 100644
--- a/src/engine/physics/world/physics_step.cpp
+++ b/src/engine/physics/world/physics_step.cpp
@@ -26,6 +26,37 @@ static u32 ComputeSubstepCount(
     return Binary32::TruncateToUint32Modulo(scaled) + 1u;
 }
 
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+// tm-physics-re: FV_TRACE_STEP=<csv> logs |v| after integration and after collision response.
+static void TmTraceStep(CHmsDyna *dyna, int stage, u32 contacts) {
+    static std::FILE *file = nullptr;
+    static bool opened = false;
+    if (!opened) {
+        opened = true;
+        const char *path = std::getenv("FV_TRACE_STEP");
+        if (path != nullptr && path[0] != '\0') {
+            file = std::fopen(path, "w");
+            if (file != nullptr) {
+                std::fprintf(file, "tick,stage,speed,vx,vy,vz,wlen,collisions\n");
+            }
+        }
+    }
+    if (file == nullptr) {
+        return;
+    }
+    GmVec3 v;
+    GmVec3 w;
+    dyna->GetLinearSpeed(v);
+    dyna->GetAngularSpeed(w);
+    std::fprintf(file, "%u,%d,%.5g,%.5g,%.5g,%.5g,%.5g,%u\n",
+                 CMwCmdBufferCore::Current()->Timer().GetTickTime(), stage,
+                 std::sqrt(v.x * v.x + v.y * v.y + v.z * v.z), v.x, v.y, v.z,
+                 std::sqrt(w.x * w.x + w.y * w.y + w.z * w.z), contacts);
+}
+
