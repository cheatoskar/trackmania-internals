+  const int tracePhaseBefore = static_cast<int>(gearedDrive.burnoutPhase);
 
   GmVec3 savedForce;
   GmVec3 savedImpulse;
@@ -1037,8 +1063,65 @@ void CSceneVehicleCar::ComputeForces(float dt) {
     OtherVehicleForces();
   }
 
+  if (TmPhysicsTraceFile() != nullptr) {
+    TraceComputeForces(dt, tick, linearSpeed, angularSpeed, visualSteerYaw,
+                       materialVals, hasGroundMaterial, tracePhaseBefore);
+  }
   UpdateFeedbackTail(tuning, dt, linearSpeed, savedForce, savedImpulse,
                      surfaceFeedback);
   ClearWheelContactScratch();
   ResetPerTickContactFeedback();
 }
+
+void CSceneVehicleCar::TraceComputeForces(
+    float dt, u32 tick, const GmVec3 &linearSpeed, const GmVec3 &angularSpeed,
+    float visualSteerYaw, const CSceneVehicleMaterial::SBlendableVals &vals,
+    int hasGroundMaterial, int phaseBefore) {
+  std::FILE *file = TmPhysicsTraceFile();
+  static u32 lastTick = 0xffffffffu;
+  static int call = 0;
+  call = (tick == lastTick) ? call + 1 : 0;
+  lastTick = tick;
+  const GmVec3 pos = HmsItem()->CorpusAt(0u)->GetLocation()->translation;
+  const GmVec3 c = gearedDrive.burnoutCenter;
+  const float dx = c.x - pos.x, dy = c.y - pos.y, dz = c.z - pos.z;
+  const float speed = std::sqrt(linearSpeed.x * linearSpeed.x +
+                                linearSpeed.y * linearSpeed.y +
+                                linearSpeed.z * linearSpeed.z);
+  std::fprintf(file,
+               "%u,%d,%.6g,%.4f,%.4f,%.4f,%.3f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,"
+               "%.3g,%.3g,%.4g,%.5g,%d,%d,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,"
+               "%.3g,%.3g,%.3g,%.3g,%d,%u,%u",
+               tick, call, dt, pos.x, pos.y, pos.z, speed * 3.6f, linearSpeed.x,
+               linearSpeed.y, linearSpeed.z, angularSpeed.x, angularSpeed.y,
+               angularSpeed.z, controls.lowSpeedGateA, controls.lowSpeedGateB,
+               controls.steeringControl, visualSteerYaw, phaseBefore,
+               static_cast<int>(gearedDrive.burnoutPhase), c.x, c.y, c.z,
+               std::sqrt(dx * dx + dy * dy + dz * dz), gearedDrive.burnoutBaseRadius,
+               gearedDrive.burnoutTargetRadius, vals.x, vals.y, vals.z, vals.w,
+               hasGroundMaterial, contacts.bodyContactCount, contacts.wheelContactCount);
+  for (size_t i = 0; i < 4; ++i) {
+    if (i < wheels.size()) {
+      const SSimulationWheel::SRealTimeState &rt = wheels[i].realTimeState;
+      std::fprintf(file, ",%d,%d,%d", rt.contactPresent ? 1 : 0,
+                   static_cast<int>(rt.contactMaterial), rt.slipping ? 1 : 0);
+    } else {
+      std::fprintf(file, ",,,");
+    }
+  }
+  for (size_t i = 0; i < 4; ++i) {
+    if (i < wheels.size()) {
+      const SSimulationWheel::SRealTimeState &rt = wheels[i].realTimeState;
+      std::fprintf(file, ",%u,%.4f,%.4f,%.4f,%.4f", rt.contactNormalSampleCount,
+                   rt.damperAbsorb, rt.accumulatedContactNormal.x,
+                   rt.accumulatedContactNormal.y, rt.accumulatedContactNormal.z);
+    } else {
+      std::fprintf(file, ",,,,,");
+    }
+  }
+  std::fprintf(file, ",%.5g,%.5g,%.5g,%.5g,%.5g,%.5g", forceAccumulators.force.x,
+               forceAccumulators.force.y, forceAccumulators.force.z,
+               forceAccumulators.impulse.x, forceAccumulators.impulse.y,
+               forceAccumulators.impulse.z);
+  std::fputc('\n', file);
+}
