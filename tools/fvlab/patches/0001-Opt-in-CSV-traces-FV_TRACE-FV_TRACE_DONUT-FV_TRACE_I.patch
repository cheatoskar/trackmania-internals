 #include "engine/scene/scene_vehicle_car_internal.h"
 using namespace SceneVehicleCarDynamics;
 
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+
+// tm-physics-re trace: FV_TRACE=<csv path> writes one row per ComputeForces call.
+static std::FILE *TmPhysicsTraceFile() {
+  static bool opened = false;
+  static std::FILE *file = nullptr;
+  if (!opened) {
+    opened = true;
+    const char *path = std::getenv("FV_TRACE");
+    if (path != nullptr && path[0] != '\0') {
+      file = std::fopen(path, "w");
+      if (file != nullptr) {
+        std::fprintf(file,
+                     "tick,call,dt,px,py,pz,kmh,vx,vy,vz,wx,wy,wz,gas,brake,steer,steer_yaw,"
+                     "phase_before,phase,cx,cy,cz,dist_center,base_r,target_r,"
+                     "blend0,blend1,blend2,blend3,has_ground,body_contacts,wheel_contacts,"
+                     "fl_c,fl_m,fl_s,fr_c,fr_m,fr_s,rr_c,rr_m,rr_s,rl_c,rl_m,rl_s,fl_n,fl_d,fl_nx,fl_ny,fl_nz,fr_n,fr_d,fr_nx,fr_ny,fr_nz,rr_n,rr_d,rr_nx,rr_ny,rr_nz,rl_n,rl_d,rl_nx,rl_ny,rl_nz,fx,fy,fz,ix,iy,iz\n");
+      }
+    }
+  }
+  return file;
+}
